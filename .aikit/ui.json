{
  "schema": 1,
  "surfaces": {
    "app": {
      "paths": [
        "web/*",
        "src/web.rs"
      ]
    }
  },
  "protected": [
    "tests/**",
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "src/**/__tests__/**"
  ],
  "commands": {
    "fast": "cargo test",
    "snapshot": "python inventory.py"
  },
  "style": {
    "theme_paths": [
      "web/styles.css"
    ]
  },
  "limits": {
    "max_files": 12,
    "max_lines": 300,
    "max_added_lines": 200,
    "max_deleted_lines": 100
  }
}